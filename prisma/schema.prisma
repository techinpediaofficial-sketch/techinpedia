model WhatsappConversation {
  id                     String    @id @default(uuid())
  companyId              String?   @db.VarChar(64)
  company                Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  waNumber               String    @db.VarChar(32) // E.164 canonical normalized phone e.g. +919818768680
  customerName           String?
  contactId              String?   @db.VarChar(64)
  leadId                 String?   @db.VarChar(64)
  customerId             String?   @db.VarChar(64)
  assignedUserId         String?   @db.VarChar(64)
  assignedTeam           String?   @default("Sales")
  status                 String    @default("OPEN") @db.VarChar(32) // OPEN, CLOSED, PENDING
  priority               String    @default("MEDIUM") @db.VarChar(32) // LOW, MEDIUM, HIGH, URGENT
  unreadCount            Int       @default(0)
  lastMessageText        String?   @db.Text
  lastMessageSender      String    @default("CONTACT") // CONTACT, AGENT, SYSTEM, TEMPLATE
  lastMessageAt          DateTime  @default(now())
  lastCustomerActivityAt DateTime? // 24-hour customer care window tracking
  labels                 String?   @db.Text // JSON array of tags/labels
  internalNotes          String?   @db.Text
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  
  assignedAt           DateTime? // Tracks when the chat was assigned
  assignmentAcceptedAt DateTime? // Tracks when the assigned rep accepted the chat
  assignmentAcceptedBy String?   // Tracks who accepted it (employee/user ID)
  firstViewedAt        DateTime? // First time the assigned employee viewed this chat
  firstResponseAt      DateTime? // First real employee outbound message after assignment

  // ── AI & Chatbot Automation ─────────────
  isAiPaused             Boolean   @default(false)
  aiPausedAt             DateTime?
  aiPausedBy             String?   @db.VarChar(64)
  lastAiHandoffReason    String?   @db.VarChar(128)
  lastAiHandoffAt        DateTime?
  activeChatbotId        String?   @db.VarChar(64)
  activeChatbotSessionId String?   @db.VarChar(64)

  // ── Template & Package Context Tracking ─────────────
  selectedPackageIdsJson String?   @db.Text // JSON array e.g. ["1", "2"]
  lastViewedPackageId    String?   @db.VarChar(64)
  bookingPackageId       String?   @db.VarChar(64)
  packageContextJson     String?   @db.Text // JSON snapshot e.g. { selectedPackagePrice: 1388, selectedTemplateId: "..." }

  // ── AI Conversation Orchestration & Handoff State ─────────────
  handoffState           String?   @default("AI_ACTIVE") @db.VarChar(32) // AI_ACTIVE, HANDOFF_REQUESTED, WAITING_FOR_AGENT, HUMAN_ACTIVE, RETURNED_TO_AI, CLOSED
  aiStateJson            String?   @db.Text // Structured memory: { current_intent, current_topic, booking_stage, current_package_id, etc. }

  messages WhatsappMessage[]

  @@index([waNumber])
  @@index([status])
  @@index([assignedUserId])
  @@index([leadId])
  @@index([contactId])
  @@index([companyId])
}

