model BackgroundJob {
  id            String    @id @db.VarChar(128) // deterministic e.g. "whatsapp:campaignId:recipientId", "google-sheet-sync:configId"
  queue         String    @db.VarChar(64) // whatsapp-campaign, whatsapp-message, whatsapp-webhook, google-sheet-sync, workflow-delayed-actions
  status        String    @default("PENDING") @db.VarChar(32) // PENDING, QUEUED, PROCESSING, COMPLETED, FAILED, RETRYING, DELAYED, CANCELLED
  payload       String    @db.LongText // JSON
  result        String?   @db.LongText // JSON
  attemptCount  Int       @default(0)
  maxAttempts   Int       @default(3)
  priority      Int       @default(0) // higher = processed earlier
  scheduledAt   DateTime? // for delayed / scheduled jobs
  startedAt     DateTime?
  completedAt   DateTime?
  failedAt      DateTime?
  lastError     String?   @db.Text
  lockedAt      DateTime?
  lockedBy      String?   @db.VarChar(128)
  correlationId String?   @db.VarChar(128)
  entityType    String?   @db.VarChar(64)
  entityId      String?   @db.VarChar(64)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([queue, status])
  @@index([scheduledAt])
  @@index([lockedAt])
  @@index([correlationId])
  @@index([entityType, entityId])
}

