  version         String?  @db.VarChar(32)

  @@index([status])
  @@index([lastHeartbeatAt])
}

// ─── STAFF TASK MANAGEMENT (independent of Project module) ──────────────────

model StaffTask {
  id              String    @id @default(uuid()) @db.VarChar(64)
  title           String
  description     String?   @db.Text
  priority        String    @default("MEDIUM") @db.VarChar(32)
  status          String    @default("TODO") @db.VarChar(32)
  dueDate         DateTime?
  completionNote  String?   @db.Text // Written by employee on completion
  isRecurring     Boolean   @default(false) // Daily auto-reset task
  recurringTime   String? // HH:MM for daily reset e.g. "09:00"
  lastResetAt     DateTime? // Last auto-reset timestamp
  createdByUserId String? // Admin/manager who created
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  assignees StaffTaskAssignee[]
  replies   StaffTaskReply[]
}

model StaffTaskAssignee {
  id           String    @id @default(uuid()) @db.VarChar(64)
  taskId       String    @db.VarChar(64)
  task         StaffTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employeeId   String?   @db.VarChar(64)
  employeeName String // stored name for display
  employeeCode String? // employee code
  assignedAt   DateTime  @default(now())
}

model StaffTaskReply {
  id         String    @id @default(uuid()) @db.VarChar(64)
  taskId     String    @db.VarChar(64)
  task       StaffTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId   String?   @db.VarChar(64)
  authorName String // employee or admin name
  authorRole String    @default("EMPLOYEE") @db.VarChar(32)
  message    String    @db.Text
  createdAt  DateTime  @default(now())
}

// ─── EMPLOYEE TRACKING & INTERNAL CHAT ──────────────────────────────

model EmployeeSession {
  id           String    @id @default(uuid()) @db.VarChar(64)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress    String?   @db.VarChar(45)
  userAgent    String?   @db.Text
  loginAt      DateTime  @default(now())
  logoutAt     DateTime?
  lastActiveAt DateTime  @default(now())
  status       String    @default("ONLINE") @db.VarChar(32) // ONLINE, IDLE, OFFLINE
}

model TeamChat {
  id        String   @id @default(uuid()) @db.VarChar(64)
  type      String   @default("DIRECT") @db.VarChar(32) // DIRECT, GROUP
  name      String?  @db.VarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants TeamChatParticipant[]
  messages     TeamChatMessage[]
}

model TeamChatParticipant {
  id       String   @id @default(uuid()) @db.VarChar(64)
  chatId   String   @db.VarChar(64)
  chat     TeamChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String   @default("MEMBER") @db.VarChar(32) // ADMIN, MEMBER
  joinedAt DateTime @default(now())
}

model TeamChatMessage {
  id       String   @id @default(uuid()) @db.VarChar(64)
  chatId   String   @db.VarChar(64)
  chat     TeamChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  senderId String
  sender   User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content  String   @db.Text

  // References to external entities (Leads/Tasks shared in chat)
  sharedLeadId String? @db.VarChar(64)
  sharedTaskId String? @db.VarChar(64)

  createdAt DateTime @default(now())

  reads TeamChatMessageRead[]
}

model TeamChatMessageRead {
  id        String          @id @default(uuid()) @db.VarChar(64)
  messageId String          @db.VarChar(64)
  message   TeamChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime        @default(now())
}

// ==========================================
// 12. HRM - RECRUITMENT & JOB OPENINGS
// ==========================================
model JobOpening {
  id               String       @id @default(uuid())
  jobId            String       @unique
  title            String
  departmentId     String?
  department       Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designationId    String?
  designation      Designation? @relation(fields: [designationId], references: [id], onDelete: SetNull)
  vacancies        Int          @default(1)
  employmentType   String       @default("FULL_TIME") // FULL_TIME, PART_TIME, INTERNSHIP, CONTRACT, FREELANCE
  workMode         String       @default("OFFICE") // OFFICE, REMOTE, HYBRID
  location         String?
  minExperience    Float?
  maxExperience    Float?
  requiredSkills   String?      @db.Text
  preferredSkills  String?      @db.Text
  minQualification String?
  salaryMin        Float?
  salaryMax        Float?
  currency         String       @default("INR")
  hiringManagerId  String?
  hiringManager    Employee?    @relation("HiringManager", fields: [hiringManagerId], references: [id], onDelete: SetNull)
  recruiterId      String?
  recruiter        Employee?    @relation("JobRecruiter", fields: [recruiterId], references: [id], onDelete: SetNull)
  description      String       @db.LongText
  responsibilities String?      @db.LongText
  requirements     String?      @db.LongText
  benefits         String?      @db.Text
  openingDate      DateTime     @default(now())
  closingDate      DateTime?
  priority         String       @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  internalNotes    String?      @db.Text
  status           String       @default("OPEN") // DRAFT, OPEN, ON_HOLD, CLOSED, CANCELLED
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  candidates Candidate[]
  interviews Interview[]
  offers     JobOffer[]
}

model Candidate {
  id                 String      @id @default(uuid())
  candidateId        String      @unique
  fullName           String
  email              String
  phone              String?
  whatsappNumber     String?
  dateOfBirth        DateTime?
  gender             String?
  city               String?
  state              String?
  address            String?     @db.Text
  currentCompany     String?
  currentDesignation String?
  currentSalary      Float?
  expectedSalary     Float?
  totalExperience    Float?
  relevantExperience Float?
  noticePeriod       Int? // in days
  lastWorkingDate    DateTime?
  skills             String?     @db.Text
  qualification      String?
  resumeUrl          String?     @db.Text
  portfolioUrl       String?     @db.Text
  linkedinUrl        String?     @db.Text
  githubUrl          String?     @db.Text
  source             String      @default("Website")
  referredById       String?
  referredBy         Employee?   @relation("CandidateReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  appliedPositionId  String?
  appliedPosition    JobOpening? @relation(fields: [appliedPositionId], references: [id], onDelete: SetNull)
  recruiterId        String?
  recruiter          Employee?   @relation("CandidateRecruiter", fields: [recruiterId], references: [id], onDelete: SetNull)
  tags               String?     @db.Text
  notes              String?     @db.Text
  rating             Int         @default(0)
  status             String      @default("APPLIED") // APPLIED, SCREENING, SHORTLISTED, INTERVIEW_SCHEDULED, INTERVIEWING, HR_ROUND, SELECTED, OFFER_SENT, OFFER_ACCEPTED, JOINED, ON_HOLD, REJECTED, WITHDREW, NO_SHOW, OFFER_REJECTED, DID_NOT_JOIN
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  interviews Interview[]
  offers     JobOffer[]
}

model Interview {
  id               String      @id @default(uuid())
  interviewId      String      @unique
  candidateId      String
  candidate        Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobOpeningId     String?
  jobOpening       JobOpening? @relation(fields: [jobOpeningId], references: [id], onDelete: SetNull)
  roundNumber      Int         @default(1)
  roundName        String
  type             String      @default("TECHNICAL") // HR_SCREENING, TECHNICAL, MACHINE_TEST, CODING, MANAGER, DIRECTOR, CLIENT, FINAL_HR, CUSTOM
  date             DateTime
  startTime        String
  expectedDuration Int         @default(60) // minutes
  mode             String      @default("GOOGLE_MEET") // IN_PERSON, PHONE, GOOGLE_MEET, ZOOM, TEAMS, OTHER
  location         String?     @db.Text
  meetingLink      String?     @db.Text
  coordinatorId    String?
  coordinator      Employee?   @relation("InterviewCoordinator", fields: [coordinatorId], references: [id], onDelete: SetNull)
  reminder         Boolean     @default(true)
  instructions     String?     @db.Text
  notes            String?     @db.Text
  status           String      @default("SCHEDULED") // SCHEDULED, IN_PROGRESS, COMPLETED, RESCHEDULED, CANCELLED, NO_SHOW
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  interviewers InterviewInterviewer[]
  feedbacks    InterviewFeedback[]
}

model InterviewInterviewer {
  id          String    @id @default(uuid())
  interviewId String    @db.VarChar(50)
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  employeeId  String    @db.VarChar(50)
  employee    Employee  @relation("Interviewer", fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([interviewId, employeeId])
}

model InterviewFeedback {
  id            String    @id @default(uuid())
  interviewId   String    @db.VarChar(50)
  interview     Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  interviewerId String    @db.VarChar(50)
  interviewer   Employee  @relation("SubmittedFeedbacks", fields: [interviewerId], references: [id], onDelete: Cascade)

  communication      Int @default(0) // 1-5
  technicalKnowledge Int @default(0)
  problemSolving     Int @default(0)
  relevantExperience Int @default(0)
  confidence         Int @default(0)
  roleUnderstanding  Int @default(0)
  cultureFit         Int @default(0)
  leadership         Int @default(0)
  teamwork           Int @default(0)
  overallSuitability Int @default(0)

  strengths            String? @db.Text
  weaknesses           String? @db.Text
  technicalNotes       String? @db.Text
  behaviorNotes        String? @db.Text
  concerns             String? @db.Text
  salaryRecommendation Float?
  recommendation       String  @default("HOLD") // STRONG_HIRE, HIRE, HOLD, REJECT

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([interviewId, interviewerId])
}

model JobOffer {
  id            String       @id @default(uuid())
  candidateId   String
  candidate     Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobOpeningId  String?
  jobOpening    JobOpening?  @relation(fields: [jobOpeningId], references: [id], onDelete: SetNull)
  designationId String?
  designation   Designation? @relation(fields: [designationId], references: [id], onDelete: SetNull)
  departmentId  String?
  department    Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  managerId     String?
  manager       Employee?    @relation("OfferManager", fields: [managerId], references: [id], onDelete: SetNull)

  proposedJoiningDate DateTime
  salary              Float
  ctc                 Float?
  probationMonths     Int      @default(3)
  employmentType      String   @default("FULL_TIME")
  workLocation        String   @default("OFFICE")
  validUntil          DateTime
  specialTerms        String?  @db.Text
  hrNotes             String?  @db.Text
  status              String   @default("DRAFT") // DRAFT, APPROVAL_PENDING, APPROVED, SENT, VIEWED, ACCEPTED, REJECTED, EXPIRED, WITHDRAWN

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// 13. HRM - PERFORMANCE & KPIs
// ==========================================
model PerformanceKpiTemplate {
  id              String       @id @default(uuid())
  name            String
  departmentId    String?
  department      Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designationId   String?
  designation     Designation? @relation(fields: [designationId], references: [id], onDelete: SetNull)
  category        String       @default("GENERAL") // SALES, DEV, DESIGN, HR, GENERAL
  weightPercent   Float        @default(10)
  target          Float        @default(100)
  measurementType String       @default("COUNT") // COUNT, PERCENTAGE, REVENUE, RATING, TIME
  minScore        Float        @default(0)
  maxScore        Float        @default(100)
  isAutomatic     Boolean      @default(false)
  dataSource      String? // e.g. "crm.deals.won", "hr.attendance.late"
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model EmployeeDailyPerformance {
  employeeId String   @db.VarChar(50)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime

  // Snapshots
  checkIn     DateTime?
  checkOut    DateTime?
  workMinutes Int       @default(0)
  isLate      Boolean   @default(false)

  tasksAssigned  Int @default(0)
  tasksCompleted Int @default(0)
  tasksPending   Int @default(0)
  tasksOverdue   Int @default(0)

  leadsAssigned  Int   @default(0)
  leadsContacted Int   @default(0)
  followUps      Int   @default(0)
  meetings       Int   @default(0)
  dealsWon       Int   @default(0)
  revenue        Float @default(0)

  targetAchieved Float @default(0)
  complaints     Int   @default(0)
  warnings       Int   @default(0)
  clientFeedback Float @default(0)
  managerRating  Float @default(0)

  finalScore    Float  @default(0)
  growthPercent Float  @default(0)
  status        String @default("STABLE") // EXCELLENT, IMPROVING, STABLE, DECLINING, CRITICAL

  createdAt DateTime @default(now())

  @@unique([employeeId, date])
  @@index([date])
}

model EmployeePerformanceScore {
  id            String   @id @default(uuid())
  employeeId    String   @db.VarChar(50)
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  periodType    String   @db.VarChar(50) // WEEK, MONTH, QUARTER, YEAR
  startDate     DateTime
  endDate       DateTime
  score         Float    @default(0)
  growthPercent Float    @default(0)
  status        String   @default("STABLE")
  createdAt     DateTime @default(now())

  @@index([employeeId, periodType, startDate])
}

model ManagerReview {
  id                 String   @id @default(uuid())
  employeeId         String
  employee           Employee @relation("EmployeeReviewed", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewerId         String
  reviewer           Employee @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  date               DateTime
  rating             String   @default("AVERAGE") // EXCELLENT, GOOD, AVERAGE, NEEDS_IMPROVEMENT, POOR
  wentWell           String?  @db.Text
  improveRequired    String?  @db.Text
  comments           String?  @db.Text
  employeeNote       String?  @db.Text
  privateNote        String?  @db.Text
  coachingRequired   Boolean  @default(false)
  warningRecommended Boolean  @default(false)
  appreciationRec    Boolean  @default(false)
  pipRecommended     Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model PerformanceThreshold {
  id         String   @id @default(uuid())
  label      String // EXCELLENT, IMPROVING, STABLE, DECLINING, CRITICAL
  minPercent Float
  maxPercent Float
  color      String   @default("#000000")
  createdAt  DateTime @default(now())
}

// ==========================================
// 14. HRM - APPRECIATION, REWARDS & PROMOTIONS
// ==========================================
model EmployeeAppreciation {
  id                String   @id @default(uuid())
  employeeId        String
  employee          Employee @relation("EmployeeAppreciated", fields: [employeeId], references: [id], onDelete: Cascade)
  type              String // GOOD_WORK, EXCELLENT_PERFORMANCE, STAR_PERFORMER, MONTH_EMPLOYEE, CLIENT, TARGET, PERFECT_ATTENDANCE, TEAM_PLAYER, INNOVATION, LEADERSHIP, CUSTOM
  title             String
  description       String   @db.Text
  reason            String   @db.Text
  performancePeriod String?
  taskId            String?
  projectId         String?
  dealId            String?
  clientId          String?
  givenById         String
  givenBy           Employee @relation("AppreciationGiver", fields: [givenById], references: [id], onDelete: Cascade)
  date              DateTime @default(now())
  certificateUrl    String?  @db.Text
  rewardAttached    Boolean  @default(false)
  visibility        String   @default("COMPANY") // EMPLOYEE_ONLY, DEPARTMENT, COMPANY, HR_ONLY
  notes             String?  @db.Text
  createdAt         DateTime @default(now())

  rewards EmployeeReward[]
}

model EmployeeReward {
  id                String                @id @default(uuid())
  employeeId        String
  employee          Employee              @relation("EmployeeRewarded", fields: [employeeId], references: [id], onDelete: Cascade)
  type              String // CASH_BONUS, INCENTIVE, GIFT, VOUCHER, PAID_LEAVE, CERTIFICATE, TROPHY, SALARY_INCREMENT, OTHER
  title             String
  value             Float                 @default(0)
  currency          String                @default("INR")
  reason            String                @db.Text
  performancePeriod String?
  appreciationId    String?
  appreciation      EmployeeAppreciation? @relation(fields: [appreciationId], references: [id], onDelete: SetNull)
  recommendedById   String?
  recommendedBy     Employee?             @relation("RewardRecommender", fields: [recommendedById], references: [id], onDelete: SetNull)
  approvedById      String?
  approvedBy        Employee?             @relation("RewardApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvalDate      DateTime?
  rewardDate        DateTime?
  paymentStatus     String                @default("PENDING") // PENDING, PROCESSING, PAID, CANCELLED
  payrollLinked     Boolean               @default(false)
  notes             String?               @db.Text
  status            String                @default("RECOMMENDED") // RECOMMENDED, MANAGER_APPROVED, HR_REVIEW, MGMT_APPROVED, APPROVED, REJECTED, PROCESSED, DELIVERED
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
}

model EmployeePromotion {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation("EmployeePromoted", fields: [employeeId], references: [id], onDelete: Cascade)

  oldDepartmentId  String?
  oldDepartment    Department?  @relation("OldDeptPromo", fields: [oldDepartmentId], references: [id], onDelete: SetNull)
  oldDesignationId String?
  oldDesignation   Designation? @relation("OldDesigPromo", fields: [oldDesignationId], references: [id], onDelete: SetNull)
  oldManagerId     String?
  oldManager       Employee?    @relation("OldManagerPromo", fields: [oldManagerId], references: [id], onDelete: SetNull)
  oldSalary        Float        @default(0)

  newDepartmentId  String?
  newDepartment    Department?  @relation("NewDeptPromo", fields: [newDepartmentId], references: [id], onDelete: SetNull)
  newDesignationId String?
  newDesignation   Designation? @relation("NewDesigPromo", fields: [newDesignationId], references: [id], onDelete: SetNull)
  newManagerId     String?
  newManager       Employee?    @relation("NewManagerPromo", fields: [newManagerId], references: [id], onDelete: SetNull)
  newSalary        Float        @default(0)

  incrementAmount   Float    @default(0)
  incrementPercent  Float    @default(0)
  effectiveDate     DateTime
  reason            String   @db.Text
  performancePeriod String?
  performanceScore  Float?

  recommendedById String?
  recommendedBy   Employee? @relation("PromoRecommender", fields: [recommendedById], references: [id], onDelete: SetNull)
  managerComments String?   @db.Text
  hrComments      String?   @db.Text
  mgmtComments    String?   @db.Text

  status    String  @default("RECOMMENDED") // RECOMMENDED, MANAGER_APPROVED, HR_REVIEW, MGMT_APPROVED, APPROVED, REJECTED, EXECUTED
  letterUrl String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// 15. HRM - WARNINGS & PIP
// ==========================================
model EmployeeWarning {
  id               String    @id @default(uuid())
  employeeId       String
  employee         Employee  @relation("EmployeeWarned", fields: [employeeId], references: [id], onDelete: Cascade)
  category         String // PERFORMANCE, ATTENDANCE, BEHAVIOUR, MISSED_TARGET, TASK_DELAY, CLIENT_COMPLAINT, POLICY, OTHER
  severity         String    @default("LOW") // LOW, MEDIUM, HIGH, CRITICAL
  reason           String    @db.Text
  details          String    @db.LongText
  evidenceUrl      String?   @db.Text
  issuedById       String
  issuedBy         Employee  @relation("WarningIssuer", fields: [issuedById], references: [id], onDelete: Cascade)
  issueDate        DateTime  @default(now())
  employeeResponse String?   @db.Text
  followUpDate     DateTime?
  resolution       String?   @db.Text
  status           String    @default("DRAFT") // DRAFT, ISSUED, ACKNOWLEDGED, UNDER_REVIEW, RESOLVED, ESCALATED
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model EmployeePip {
  id                  String   @id @default(uuid())
  employeeId          String
  employee            Employee @relation("EmployeePip", fields: [employeeId], references: [id], onDelete: Cascade)
  reason              String   @db.Text
  problemDescription  String   @db.LongText
  currentPerformance  String   @db.Text
  expectedPerformance String   @db.Text
  kpiTargets          String   @db.Text
  startDate           DateTime
  endDate             DateTime
  reviewFrequency     String   @default("WEEKLY") // WEEKLY, BIWEEKLY, MONTHLY
  managerId           String
  manager             Employee @relation("PipManager", fields: [managerId], references: [id], onDelete: Cascade)
  hrOwnerId           String
  hrOwner             Employee @relation("PipHrOwner", fields: [hrOwnerId], references: [id], onDelete: Cascade)
  improvementActions  String   @db.Text
  trainingRequired    String?  @db.Text
  managerNotes        String?  @db.Text
  employeeComments    String?  @db.Text
  progress            Int      @default(0) // 0 to 100
  finalResult         String?  @db.Text
  status              String   @default("DRAFT") // DRAFT, ACTIVE, IMPROVING, EXTENDED, COMPLETED, FAILED, CANCELLED
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  reviews PipReview[]
}

model PipReview {
  id               String      @id @default(uuid())
  pipId            String
  pip              EmployeePip @relation(fields: [pipId], references: [id], onDelete: Cascade)
  date             DateTime    @default(now())
  kpiProgress      String      @db.Text
  managerRating    String      @default("AVERAGE") // IMPROVING, NO_CHANGE, DECLINING, SATISFACTORY, UNSATISFACTORY
  employeeComments String?     @db.Text
  evidence         String?     @db.Text
  nextActions      String?     @db.Text
  createdAt        DateTime    @default(now())
}

// ==========================================
// 16. HRM - CAREER TIMELINE & RULES
// ==========================================
model EmployeeCareerEvent {
  id          String   @id @default(uuid())
  employeeId  String
  employee    Employee @relation("CareerEvents", fields: [employeeId], references: [id], onDelete: Cascade)
  type        String // JOINING, DEPT_CHANGE, DESIG_CHANGE, SALARY_REVISION, PROMOTION, APPRECIATION, BONUS, GIFT, AWARD, WARNING, PIP, PERFORMANCE_REVIEW, TRANSFER, MANAGER_CHANGE, ACHIEVEMENT
  title       String
  description String?  @db.Text
  date        DateTime @default(now())
  metadata    String?  @db.Text // JSON string for extra fields
  createdAt   DateTime @default(now())
}

model RecognitionRule {
  id            String       @id @default(uuid())
  name          String
  condition     String // JSON logic or string representation
  threshold     String // Threshold value
  action        String // RECOMMEND_APPRECIATION, RECOMMEND_PROMOTION, RECOMMEND_BONUS
  departmentId  String?
  department    Department?  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  designationId String?
  designation   Designation? @relation(fields: [designationId], references: [id], onDelete: Cascade)
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

// ==========================================
// 17. URBAN MARKETPLACE - VENDOR 360 PROFILE SUITE
// ==========================================
model MarketplaceVendor {
  id                String   @id @default(uuid())
  companyId         String?
  enquiryId         String?
  slug              String   @unique
  businessName      String
  tagline           String?
  description       String?  @db.Text
  logoUrl           String?  @db.Text
  coverImageUrl     String?  @db.Text
  ownerName         String?
  phone             String
  whatsappNumber    String?
  email             String?
  website           String?
  address           String?  @db.Text
  locality          String?
  city              String   @default("Delhi NCR")
  state             String?  @default("Delhi")
  pincode           String?
  establishmentYear Int?     @default(2020)
  businessType      String   @default("SERVICE_PROVIDER") // SERVICE_PROVIDER, DEALER, MANUFACTURER, WHOLESALER
  primaryCategory   String   @default("AC Repair & Services")
  categories        String?  @db.Text // JSON array e.g. ["AC Repair & Services", "AC Installation"]
  openingHours      String?  @db.Text // JSON string
  gstin             String?
  kycStatus         String   @default("PENDING") // PENDING, VERIFIED, REJECTED
  kycDocuments      String?  @db.Text // JSON array of uploaded documents
  membershipTier    String   @default("STARTER") // STARTER, GROWTH, ENTERPRISE
  leadCredits       Int      @default(10)
  isClaimed         Boolean  @default(true)
  isVerified        Boolean  @default(false)
  isFeatured        Boolean  @default(false)
  averageRating     Decimal  @default(4.50) @db.Decimal(3, 2)
  ratingCount       Int      @default(12)
  reviewCount       Int      @default(12)
  quickInfo         String?  @db.Text // JSON string: paymentModes, parking, etc.
  status            String   @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  media    MarketplaceVendorMedia[]
  services MarketplaceVendorService[]
  reviews  MarketplaceVendorReview[]

  @@index([city])
  @@index([primaryCategory])
  @@index([kycStatus])
  @@index([status])
  @@index([isVerified])
}

model MarketplaceVendorMedia {
  id             String            @id @default(uuid())
  vendorId       String
  vendor         MarketplaceVendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  mediaType      String            @default("PHOTO") // PHOTO, VIDEO, SCANNED_RATE_CARD, DOCUMENT
  sourceCategory String            @default("OWNER") // OWNER, CUSTOMER, OFFICE, WORK_PORTFOLIO
  url            String            @db.Text
  thumbnailUrl   String?           @db.Text
  title          String?
  displayOrder   Int               @default(0)
  createdAt      DateTime          @default(now())

  @@index([vendorId])
  @@index([mediaType])
}

model MarketplaceVendorService {
  id           String            @id @default(uuid())
  vendorId     String
  vendor       MarketplaceVendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  title        String
  description  String?           @db.Text
  price        Decimal           @default(0.00) @db.Decimal(10, 2)
  priceUnit    String            @default("onwards / visit") // onwards / visit, per unit, per sqft
  duration     String?
  imageUrl     String?           @db.Text
  isPopular    Boolean           @default(false)
  displayOrder Int               @default(0)
  status       String            @default("ACTIVE")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([vendorId])
}

model MarketplaceVendorReview {
  id            String            @id @default(uuid())
  vendorId      String
  vendor        MarketplaceVendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  reviewerName  String
  reviewerPhone String?
  rating        Int               @default(5)
  comment       String            @db.Text
  reviewTags    String?           @db.Text // JSON array e.g. ["Reasonably priced", "Excellent service"]
  ownerReply    String?           @db.Text
  status        String            @default("APPROVED") // APPROVED, PENDING, HIDDEN
  createdAt     DateTime          @default(now())

  @@index([vendorId])
  @@index([status])
}

// ==========================================
// 18. URBAN MARKETPLACE - DYNAMIC CATEGORIES
// ==========================================
model MarketplaceCategory {
  id              String   @id @default(uuid())
  name            String
  slug            String   @unique
  mode            String   @default("B2C") // B2C, B2B
  parentId        String?
  tagline         String?
  iconName        String   @default("Wrench")
  popularItems    String?  @db.Text // JSON array e.g. ["Deep Jet Cleaning", "Gas Leakage Fix"]
  metaTitle       String?
  metaDescription String?  @db.Text
  displayOrder    Int      @default(0)
  status          String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([mode])
  @@index([status])
  @@index([slug])
  @@index([parentId])
}

// ==========================================
// 19. SLA RULES — Configurable per Company
// ==========================================
model SlaRule {
  id          String   @id @default(uuid())
  companyId   String?  @db.VarChar(64)
  company     Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  // What this rule applies to
  entityType  String   @db.VarChar(32) // LEAD, WHATSAPP_CHAT, TICKET
  // What action this governs
  actionType  String   @db.VarChar(64) // ACCEPTANCE, FIRST_RESPONSE, RESOLUTION
  // Priority tier this rule applies to
  priority    String   @default("NORMAL") @db.VarChar(32) // NORMAL, HIGH, URGENT, VIP
  
  // Time limits in minutes
  warningMinutes Int   @default(8)   // Show warning at this point
  breachMinutes  Int   @default(10)  // SLA breached at this point
  
  // Auto-escalation actions (comma-separated)
  // NOTIFY_EMPLOYEE, NOTIFY_MANAGER, NOTIFY_OWNER, AUTO_REASSIGN, RETURN_TO_QUEUE
  escalationActions String? @db.Text
  
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, entityType, actionType, priority])
  @@index([companyId])
}

// ==========================================
// 20. RESOURCE VISIBILITY — Reusable for Leads & WhatsApp
// ==========================================
model ResourceVisibility {
  id           String   @id @default(uuid())
  companyId    String   @db.VarChar(64)
  
  // Polymorphic resource reference
  resourceType String   @db.VarChar(32) // LEAD, WHATSAPP_CONVERSATION
  resourceId   String   @db.VarChar(64)
  
  // Visibility policy
  visibilityType String  @db.VarChar(64)
  // ASSIGNED_ONLY, SELECTED_EMPLOYEES, SELECTED_TEAM, SELECTED_DEPARTMENT,
  // MANAGERS_ONLY, OWNER_ONLY, ALL_AUTHORIZED, HIDDEN
  
  // Selected employee / team / department IDs (JSON arrays)
  employeeIds  String?  @db.Text  // JSON array of user IDs
  teamIds      String?  @db.Text  // JSON array of team IDs
  departmentIds String? @db.Text  // JSON array of department IDs

  setByUserId  String?  @db.VarChar(64)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([resourceType, resourceId])
  @@index([companyId, resourceType])
  @@index([resourceId])
}

// ==========================================
// 21. REASSIGNMENT HISTORY — Never overwrite, always append
// ==========================================
model ReassignmentHistory {
  id              String   @id @default(uuid())
  companyId       String?  @db.VarChar(64)
  
  // Polymorphic
  resourceType    String   @db.VarChar(32) // LEAD, WHATSAPP_CONVERSATION
  resourceId      String   @db.VarChar(64)
  
  fromUserId      String?  @db.VarChar(64) // previous assignee
  toUserId        String   @db.VarChar(64) // new assignee
  reassignedBy    String   @db.VarChar(64) // who performed the reassignment
  reason          String?  @db.VarChar(64) // NO_RESPONSE, SLA_BREACHED, etc.
  notes           String?  @db.Text
  
  createdAt       DateTime @default(now())

  @@index([resourceType, resourceId])
  @@index([companyId])
  @@index([toUserId])
}

// ==========================================
// 22. EMPLOYEE LIVE STATUS — Application-level only
// ==========================================
model EmployeeStatus {
  id              String   @id @default(uuid())
  userId          String   @unique @db.VarChar(64)
  companyId       String?  @db.VarChar(64)
  
  // Current status
  status          String   @default("OFFLINE") @db.VarChar(32)
  // ONLINE, OFFLINE, AVAILABLE, BUSY, HANDLING_LEAD, HANDLING_CHAT, HANDLING_TICKET, ON_BREAK, ON_LEAVE
  
  // Current active work
  currentLeadId   String?  @db.VarChar(64)
  currentChatId   String?  @db.VarChar(64)
  currentTicketId String?  @db.VarChar(64)
  
  lastActivityAt  DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([companyId])
  @@index([status])
}

// ==========================================
// 23. WHATSAPP CHATBOT BUILDER & FLOW SESSIONS
// ==========================================
model WhatsappChatbot {
  id                 String           @id @default(uuid())
  companyId          String?          @db.VarChar(64)
  company            Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name               String           @db.VarChar(128)
  description        String?          @db.Text
  triggerType        String           @default("KEYWORD") @db.VarChar(32) // NEW_CONVERSATION, KEYWORD, CAMPAIGN, MANUAL, INTENT
  triggerKeywords    String?          @db.Text // JSON Array of keyword strings
  triggerIntent      String?          @db.VarChar(64)
  status             String           @default("DRAFT") @db.VarChar(32) // DRAFT, ACTIVE, PAUSED, ARCHIVED
  isDefault          Boolean          @default(false)
  
  draftVersion       Int              @default(1)
  publishedVersion   Int              @default(0)
  nodesJson          String           @db.MediumText // Draft flow nodes
  edgesJson          String?          @db.MediumText // Draft flow edges
  publishedNodesJson String?          @db.MediumText // Active published nodes
  publishedEdgesJson String?          @db.MediumText // Active published edges
  
  createdById        String?          @db.VarChar(64)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  sessions           ChatbotSession[]

  @@index([companyId])
  @@index([status])
  @@index([triggerType])
}

model ChatbotSession {
  id             String          @id @default(uuid())
  botId          String          @db.VarChar(64)
  bot            WhatsappChatbot @relation(fields: [botId], references: [id], onDelete: Cascade)
  companyId      String?         @db.VarChar(64)
  contactId      String?         @db.VarChar(64)
  contact        Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  conversationId String?         @db.VarChar(64)
  currentNodeId  String          @db.VarChar(64)
  variablesJson  String?         @db.Text // JSON Map of session variables
  status         String          @default("ACTIVE") @db.VarChar(32) // ACTIVE, WAITING_FOR_USER, WAITING_FOR_DELAY, HANDED_OFF, COMPLETED, FAILED, CANCELLED
  handoffReason  String?         @db.VarChar(128)
  assignedUserId String?         @db.VarChar(64)
  startedAt      DateTime        @default(now())
  lastStepAt     DateTime        @default(now())
  completedAt    DateTime?

  @@index([botId])
  @@index([companyId])
  @@index([conversationId])
  @@index([contactId])
  @@index([status])
}

// ==========================================
// 24. AI BRAIN & TENANT CONFIGURATION
// ==========================================
model AiConfig {
  id                      String   @id @default(uuid())
  companyId               String   @unique @db.VarChar(64)
  company                 Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  // Provider & Model
  provider                String   @default("OPENAI") @db.VarChar(32) // OPENAI, ANTHROPIC, GEMINI, CUSTOM
  model                   String   @default("gpt-4o-mini") @db.VarChar(64)
  apiKeyEncrypted         String?  @db.Text
  keyStrategy             String   @default("PLATFORM_MANAGED") @db.VarChar(32) // PLATFORM_MANAGED, TENANT_PROVIDED
  fallbackProvider        String?  @db.VarChar(32)
  fallbackModel           String?  @db.VarChar(64)
  temperature             Float    @default(0.7)
  maxTokens               Int      @default(500)
  
  // Usage limits & quotas
  monthlyTokenLimit       Int      @default(500000)
  dailyRequestLimit       Int      @default(2000)
  maxCostMonthly          Float    @default(50.0)
  currentMonthTokens      Int      @default(0)
  currentDayRequests      Int      @default(0)
  enabled                 Boolean  @default(true)
  
  // Persona & Tone
  botName                 String   @default("Assistant") @db.VarChar(64)
  role                    String   @default("Customer Support & Sales") @db.VarChar(128)
  primaryTone             String   @default("Professional & Corporate") @db.VarChar(64)
  basePersonality         String?  @db.Text
  dynamicPersonaEnabled   Boolean  @default(false)
  
  // Brand Context
  brandName               String?  @db.VarChar(128)
  brandDescription        String?  @db.Text
  productsSummary         String?  @db.Text
  workingHours            String?  @db.Text
  supportPolicies         String?  @db.Text
  refundPolicy            String?  @db.Text
  disclaimers             String?  @db.Text
  defaultLanguage         String   @default("en") @db.VarChar(16)
  allowedLanguages        String?  @db.Text // JSON Array of ISO codes
  
  // Guardrails & Policy
  responsePolicy          String   @default("PREFER_KNOWLEDGE") @db.VarChar(32) // KNOWLEDGE_ONLY, PREFER_KNOWLEDGE, GENERAL_FALLBACK
  autoHandoffOnFrustration Boolean @default(true)
  handoffThresholdScore   Float    @default(0.7)
  toolsEnabledJson        String?  @db.Text // JSON array of enabled tool keys
  handoffMessage          String?  @db.Text // Message shown to user upon human handoff
  offlineMessage          String?  @db.Text // Message shown when query arrives outside business hours
  routingDepartment       String?  @default("SALES") @db.VarChar(64) // Default escalation team: SALES, SUPPORT, BILLING
  
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([companyId])
}

// ==========================================
// 25. AI KNOWLEDGE BASE & RETRIEVAL
// ==========================================
model AiKnowledgeBase {
  id          String             @id @default(uuid())
  companyId   String?            @db.VarChar(64)
  company     Company?           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sourceType  String             @default("MANUAL_QA") @db.VarChar(32) // MANUAL_QA, FAQ, TEXT, DOCUMENT, URL
  title       String             @db.VarChar(255)
  content     String             @db.MediumText
  category    String?            @db.VarChar(64)
  tags        String?            @db.Text // JSON array
  priority    Int                @default(10)
  status      String             @default("ACTIVE") @db.VarChar(32) // DRAFT, ACTIVE, ARCHIVED
  syncStatus  String             @default("READY") @db.VarChar(32) // PENDING, PROCESSING, READY, FAILED, OUTDATED
  version     Int                @default(1)
  totalChunks Int                @default(1)
  fileUrl     String?            @db.Text
  fileName    String?            @db.VarChar(255)
  fileMime    String?            @db.VarChar(64)
  createdById String?            @db.VarChar(64)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  chunks      AiKnowledgeChunk[]

  @@index([companyId])
  @@index([sourceType])
  @@index([status])
}

model AiKnowledgeChunk {
  id              String           @id @default(uuid())
  knowledgeBaseId String           @db.VarChar(64)
  knowledgeBase   AiKnowledgeBase  @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  companyId       String?          @db.VarChar(64)
  chunkIndex      Int              @default(0)
  content         String           @db.MediumText
  metadata        String?          @db.Text // JSON metadata
  tokenCount      Int              @default(0)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([knowledgeBaseId])
  @@index([companyId])
  @@index([isActive])
}

model AiKnowledgeSuggestion {
  id             String    @id @default(uuid())
  companyId      String?   @db.VarChar(64)
  company        Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  question       String    @db.Text
  proposedAnswer String    @db.Text
  frequency      Int       @default(1)
  sourceQuery    String?   @db.Text
  status         String    @default("PENDING") @db.VarChar(32) // PENDING, APPROVED, REJECTED
  reviewedById   String?   @db.VarChar(64)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([companyId])
  @@index([status])
}

// ==========================================
// 26. AI GOALS
// ==========================================
model AiGoal {
  id                  String   @id @default(uuid())
  companyId           String?  @db.VarChar(64)
  company             Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  goalKey             String   @db.VarChar(64) // CAPTURE_LEAD, QUALIFY_LEAD, BOOK_APPOINTMENT, SUPPORT_RESOLVE
  name                String   @db.VarChar(128)
  description         String?  @db.Text
  priority            Int      @default(5)
  successCriteriaJson String?  @db.Text // JSON criteria
  allowedActionsJson  String?  @db.Text // JSON array of allowed actions
  handoffBehavior     String   @default("CONTINUE") @db.VarChar(32) // CONTINUE, HANDOFF_ON_SUCCESS, STOP
  isEnabled           Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([companyId])
  @@index([goalKey])
  @@index([isEnabled])
}

// ==========================================
// 27. AI INTENTS & INTENT ROUTING
// ==========================================
model AiIntent {
  id                    String   @id @default(uuid())
  companyId             String?  @db.VarChar(64)
  company               Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                  String   @db.VarChar(64) // pricing_query, human_agent, etc.
  description           String?  @db.Text
  exampleUtterancesJson String   @db.Text // JSON Array of sample user utterances
  priority              Int      @default(5) // Higher executes first
  isEnabled             Boolean  @default(true)
  actionType            String   @default("AI_RESPONSE") @db.VarChar(64) // TRIGGER_CHATBOT, SEND_REPLY, SEND_TEMPLATE, ASSIGN_EMPLOYEE, HUMAN_HANDOFF, START_DRIP
  actionPayloadJson     String?  @db.Text // JSON configuration for action
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([companyId])
  @@index([name])
  @@index([isEnabled])
}

// ==========================================
// 28. AI USAGE AUDIT & LOGGING
// ==========================================
model AiUsageLog {
  id               String   @id @default(uuid())
  companyId        String?  @db.VarChar(64)
  company          Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversationId   String?  @db.VarChar(64)
  contactId        String?  @db.VarChar(64)
  contact          Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  provider         String   @db.VarChar(32)
  model            String   @db.VarChar(64)
  feature          String   @db.VarChar(64) // CHATBOT, COPILOT, INTENT_DETECTION, SUMMARY, LEAD_QUALIFICATION
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  estimatedCost    Float    @default(0.0)
  latencyMs        Int      @default(0)
  isFallback       Boolean  @default(false)
  intent           String?  @db.VarChar(64)
  confidence       Float?   @default(1.0)
  toolsCalled      String?  @db.Text // JSON array of tool names called
  retrievedKnowledgeIds String? @db.Text // JSON array of chunk IDs
  handoffDecision  String?  @db.VarChar(64) // HANDOFF, ACTION, ANSWER, CLARIFICATION
  error            String?  @db.Text
  createdAt        DateTime @default(now())

  @@index([companyId])
  @@index([feature])
  @@index([createdAt])
}

model AiFeedback {
  id          String   @id @default(uuid())
  companyId   String?  @db.VarChar(64)
  company     Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  messageId   String?  @db.VarChar(64)
  rating      String   @db.VarChar(32) // HELPFUL, INCORRECT, NEEDS_IMPROVEMENT
  correction  String?  @db.Text
  createdById String?  @db.VarChar(64)
  createdAt   DateTime @default(now())

  @@index([companyId])
  @@index([rating])
}

